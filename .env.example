# =====================================================================
# ProcureX environment
# Copy to .env and fill in. NEVER commit the filled-in file.
# =====================================================================

APP_URL=https://app.buildprocure.com

# --- Database ---
MYSQL_HOST=db
MYSQL_DATABASE=procurex
MYSQL_USER=
MYSQL_PASSWORD=

# --- Mail (SMTP) ---
# Transactional providers with free tiers: Brevo (300/day),
# Mailgun, Postmark, Amazon SES.
MAIL_ENABLED=true
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=rfq@buildprocure.com
MAIL_FROM_NAME=BuildProcure
MAIL_REPLY_TO=
